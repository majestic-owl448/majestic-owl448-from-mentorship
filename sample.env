# Copy to .env and fill in — `cp sample.env .env`. Values below are placeholders.

# SQLite file, resolved relative to the project root.
DATABASE_URL="file:./data.db"

# SuperTokens core connection (managed cloud: https://supertokens.com/dashboard)
SUPERTOKENS_CONNECTION_URI=https://<your-instance>.aws.supertokens.io
SUPERTOKENS_API_KEY="<your-core-api-key>"

NEXT_PUBLIC_APP_NAME=majestic-owl448
NEXT_PUBLIC_API_DOMAIN=http://localhost:3000
NEXT_PUBLIC_WEBSITE_DOMAIN=http://localhost:3000

# Social login OAuth apps
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple: Services ID as the client ID, plus the Sign in with Apple key.
# Keep the private key on one line, with literal \n escapes between the lines.
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_TEAM_ID=
APPLE_PRIVATE_KEY=""
