generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  USER
  MODERATOR
}

enum TimeZoneMode {
  SYSTEM
  CUSTOM
}

enum PostalEntityStatus {
  PENDING
}

enum FaceValueType {
  MONETARY
  NAMED
  NONE
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
  MERGED
}

model UserProfile {
  id                           String                             @id
  email                        String?
  role                         UserRole                           @default(USER)
  activePostalEntitySettingId  String?                            @unique @map("active_postal_entity_setting_id")
  activePostalEntitySetting    UserPostalEntitySetting?           @relation("ActivePostalEntitySetting", fields: [activePostalEntitySettingId], references: [id], onDelete: SetNull)
  postalEntitySettings         UserPostalEntitySetting[]          @relation("UserPostalEntitySettings")
  submittedPostalEntities      PostalEntity[]                     @relation("SubmittedPostalEntities")
  stampInventoryEntries        StampInventoryEntry[]
  namedDefinitionProposals     NamedFaceValueDefinitionProposal[]
  namedValueProposals          NamedFaceValueValueProposal[]
  currencyConversionProposals  CurrencyConversionProposal[]
  moderatedDefinitionProposals NamedFaceValueDefinitionProposal[] @relation("NamedDefinitionModerator")
  moderatedValueProposals      NamedFaceValueValueProposal[]      @relation("NamedValueModerator")
  moderatedConversionProposals CurrencyConversionProposal[]       @relation("CurrencyConversionModerator")
  createdAt                    DateTime                           @default(now()) @map("created_at")
  updatedAt                    DateTime                           @updatedAt @map("updated_at")

  @@map("user_profiles")
}

model StampInventoryEntry {
  id                        String                            @id @default(cuid())
  userId                    String                            @map("user_id")
  countryCode               String                            @map("country_code")
  postalEntityId            String                            @map("postal_entity_id")
  name                      String
  yearOfIssue               Int?                              @map("year_of_issue")
  faceValueType             FaceValueType                     @default(MONETARY) @map("face_value_type")
  faceAmount                String?                           @map("face_amount")
  faceCurrencyCode          String?                           @map("face_currency_code")
  namedFaceValueId          String?                           @map("named_face_value_id")
  namedFaceValueProposalId  String?                           @map("named_face_value_proposal_id")
  manualPostageAmount       String?                           @map("manual_postage_amount")
  manualPostageCurrencyCode String?                           @map("manual_postage_currency_code")
  quantityOwned             Int                               @map("quantity_owned")
  quantityAnnulled          Int                               @default(0) @map("quantity_annulled")
  expired                   Boolean                           @default(false)
  user                      UserProfile                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  postalEntity              PostalEntity                      @relation(fields: [postalEntityId, countryCode], references: [id, countryCode], onDelete: Restrict)
  namedFaceValue            NamedFaceValue?                   @relation(fields: [namedFaceValueId], references: [id], onDelete: Restrict)
  namedFaceValueProposal    NamedFaceValueDefinitionProposal? @relation(fields: [namedFaceValueProposalId, countryCode], references: [id, countryCode], onDelete: Restrict)
  createdAt                 DateTime                          @default(now()) @map("created_at")
  updatedAt                 DateTime                          @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("stamp_inventory_entries")
}

model PostalEntity {
  id                    String                    @id @default(cuid())
  name                  String
  normalizedName        String                    @map("normalized_name")
  countryCode           String                    @map("country_code")
  status                PostalEntityStatus        @default(PENDING)
  submittedById         String?                   @map("submitted_by_id")
  submittedBy           UserProfile?              @relation("SubmittedPostalEntities", fields: [submittedById], references: [id], onDelete: SetNull)
  userSettings          UserPostalEntitySetting[]
  stampInventoryEntries StampInventoryEntry[]
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")

  @@unique([id, countryCode])
  @@index([countryCode, normalizedName])
  @@map("postal_entities")
}

model UserPostalEntitySetting {
  id                  String       @id @default(cuid())
  userId              String       @map("user_id")
  postalEntityId      String       @map("postal_entity_id")
  displayCurrencyCode String       @map("display_currency_code")
  timeZone            String       @map("time_zone")
  timeZoneMode        TimeZoneMode @map("time_zone_mode")
  user                UserProfile  @relation("UserPostalEntitySettings", fields: [userId], references: [id], onDelete: Cascade)
  postalEntity        PostalEntity @relation(fields: [postalEntityId], references: [id], onDelete: Restrict)
  activeFor           UserProfile? @relation("ActivePostalEntitySetting")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  @@unique([userId, postalEntityId])
  @@map("user_postal_entity_settings")
}

model Currency {
  code                    String                       @id
  displayName             String                       @map("display_name")
  conversionsFrom         CurrencyConversion[]         @relation("ConversionSourceCurrency")
  conversionsTo           CurrencyConversion[]         @relation("ConversionTargetCurrency")
  conversionProposalsFrom CurrencyConversionProposal[] @relation("ProposalSourceCurrency")
  conversionProposalsTo   CurrencyConversionProposal[] @relation("ProposalTargetCurrency")
  valueSchedules          ValueSchedule[]

  @@map("currencies")
}

model CurrencyConversion {
  id               String                       @id @default(cuid())
  fromCurrencyCode String                       @map("from_currency_code")
  toCurrencyCode   String                       @map("to_currency_code")
  multiplier       String
  fromCurrency     Currency                     @relation("ConversionSourceCurrency", fields: [fromCurrencyCode], references: [code], onDelete: Restrict)
  toCurrency       Currency                     @relation("ConversionTargetCurrency", fields: [toCurrencyCode], references: [code], onDelete: Restrict)
  proposals        CurrencyConversionProposal[]
  createdAt        DateTime                     @default(now()) @map("created_at")
  updatedAt        DateTime                     @updatedAt @map("updated_at")

  @@unique([fromCurrencyCode, toCurrencyCode])
  @@map("currency_conversions")
}

model CurrencyConversionProposal {
  id                         String              @id @default(cuid())
  submittedById              String              @map("submitted_by_id")
  targetCurrencyConversionId String?             @map("target_currency_conversion_id")
  fromCurrencyCode           String              @map("from_currency_code")
  toCurrencyCode             String              @map("to_currency_code")
  multiplier                 String
  sourceUrl                  String?             @map("source_url")
  sourceNote                 String?             @map("source_note")
  status                     ProposalStatus      @default(PENDING)
  moderatedById              String?             @map("moderated_by_id")
  decidedAt                  DateTime?           @map("decided_at")
  decisionNote               String?             @map("decision_note")
  submittedBy                UserProfile         @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  moderatedBy                UserProfile?        @relation("CurrencyConversionModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  targetCurrencyConversion   CurrencyConversion? @relation(fields: [targetCurrencyConversionId], references: [id], onDelete: Restrict)
  fromCurrency               Currency            @relation("ProposalSourceCurrency", fields: [fromCurrencyCode], references: [code], onDelete: Restrict)
  toCurrency                 Currency            @relation("ProposalTargetCurrency", fields: [toCurrencyCode], references: [code], onDelete: Restrict)
  createdAt                  DateTime            @default(now()) @map("created_at")

  @@index([submittedById, status, createdAt])
  @@index([submittedById, fromCurrencyCode, toCurrencyCode, status, createdAt])
  @@index([moderatedById])
  @@map("currency_conversion_proposals")
}

model ValueSchedule {
  id              String               @id @default(cuid())
  countryCode     String               @map("country_code")
  currencyCode    String               @map("currency_code")
  currency        Currency             @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  values          ValueScheduleValue[]
  namedFaceValues NamedFaceValue[]
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@unique([id, countryCode])
  @@map("value_schedules")
}

model ValueScheduleValue {
  id              String        @id @default(cuid())
  valueScheduleId String        @map("value_schedule_id")
  amount          String
  effectiveOn     String?       @map("effective_on")
  valueSchedule   ValueSchedule @relation(fields: [valueScheduleId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@unique([valueScheduleId, effectiveOn])
  @@map("value_schedule_values")
}

model NamedFaceValue {
  id                    String                             @id @default(cuid())
  countryCode           String                             @map("country_code")
  displayCode           String                             @map("display_code")
  normalizedCode        String                             @map("normalized_code")
  valueScheduleId       String                             @map("value_schedule_id")
  valueSchedule         ValueSchedule                      @relation(fields: [valueScheduleId, countryCode], references: [id, countryCode], onDelete: Restrict)
  stampInventoryEntries StampInventoryEntry[]
  definitionProposals   NamedFaceValueDefinitionProposal[] @relation("CorrectedNamedFaceValue")
  approvedProposals     NamedFaceValueDefinitionProposal[] @relation("ApprovedNamedFaceValue")
  valueProposals        NamedFaceValueValueProposal[]
  createdAt             DateTime                           @default(now()) @map("created_at")
  updatedAt             DateTime                           @updatedAt @map("updated_at")

  @@unique([countryCode, normalizedCode])
  @@unique([id, countryCode])
  @@map("named_face_values")
}

model NamedFaceValueDefinitionProposal {
  id                       String                        @id @default(cuid())
  submittedById            String                        @map("submitted_by_id")
  targetNamedFaceValueId   String?                       @map("target_named_face_value_id")
  approvedNamedFaceValueId String?                       @map("approved_named_face_value_id")
  countryCode              String                        @map("country_code")
  displayCode              String                        @map("display_code")
  normalizedCode           String                        @map("normalized_code")
  currencyCode             String                        @map("currency_code")
  sourceUrl                String?                       @map("source_url")
  sourceNote               String?                       @map("source_note")
  status                   ProposalStatus                @default(PENDING)
  moderatedById            String?                       @map("moderated_by_id")
  decidedAt                DateTime?                     @map("decided_at")
  decisionNote             String?                       @map("decision_note")
  submittedBy              UserProfile                   @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  moderatedBy              UserProfile?                  @relation("NamedDefinitionModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  targetNamedFaceValue     NamedFaceValue?               @relation("CorrectedNamedFaceValue", fields: [targetNamedFaceValueId], references: [id], onDelete: Restrict)
  approvedNamedFaceValue   NamedFaceValue?               @relation("ApprovedNamedFaceValue", fields: [approvedNamedFaceValueId], references: [id], onDelete: Restrict)
  valueProposals           NamedFaceValueValueProposal[]
  stampInventoryEntries    StampInventoryEntry[]
  createdAt                DateTime                      @default(now()) @map("created_at")

  @@unique([id, countryCode])
  @@index([submittedById, status, createdAt])
  @@index([countryCode, normalizedCode])
  @@index([moderatedById])
  @@map("named_face_value_definition_proposals")
}

model NamedFaceValueValueProposal {
  id                   String                            @id @default(cuid())
  submittedById        String                            @map("submitted_by_id")
  namedFaceValueId     String?                           @map("named_face_value_id")
  definitionProposalId String?                           @map("definition_proposal_id")
  amount               String
  effectiveOn          String?                           @map("effective_on")
  eligibleOn           String                            @map("eligible_on")
  sourceUrl            String?                           @map("source_url")
  sourceNote           String?                           @map("source_note")
  status               ProposalStatus                    @default(PENDING)
  moderatedById        String?                           @map("moderated_by_id")
  decidedAt            DateTime?                         @map("decided_at")
  decisionNote         String?                           @map("decision_note")
  submittedBy          UserProfile                       @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  moderatedBy          UserProfile?                      @relation("NamedValueModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  namedFaceValue       NamedFaceValue?                   @relation(fields: [namedFaceValueId], references: [id], onDelete: Restrict)
  definitionProposal   NamedFaceValueDefinitionProposal? @relation(fields: [definitionProposalId], references: [id], onDelete: Restrict)
  createdAt            DateTime                          @default(now()) @map("created_at")

  @@index([submittedById, status, createdAt])
  @@index([namedFaceValueId, effectiveOn])
  @@index([definitionProposalId, effectiveOn])
  @@index([moderatedById])
  @@map("named_face_value_value_proposals")
}
